#include <Arduino.h>
#include <Servo.h>

// Servo pin mappings
const int clawPin = 6;
const int basePin = 9;
const int arm1Pin = 10;
const int arm2Pin = 11;

// Create servo objects
Servo clawServo;
Servo baseServo;
Servo arm1Servo;
Servo arm2Servo;

// Global variables for target coordinates
float targetX = 0.0;
float targetY = 0.0;
float targetZ = 0.0;

// Robot arm link lengths (adjust these to match your physical arm dimensions in mm)
const float L1 = 135.0; // Length of arm segment 1
const float L2 = 100.0; // Length of arm segment 2

// Function declarations
void parseCommand(String command);
void executeMoveSequence(float x, float y, float z);
bool calculateIK(float x, float y, float z, int &baseAngle, int &arm1Angle, int &arm2Angle);
void moveArmSmoothly(int targetBase, int targetArm1, int targetArm2, int speedDelay);

void setup() {
  // Initialize Serial communication matching the Python script baud rate
  Serial.begin(115200);
  while (!Serial) {
    ; // Wait for serial port to connect
  }
  
  // Attach all servos immediately so they hold position and never go limp
  clawServo.attach(clawPin);
  baseServo.attach(basePin);
  arm1Servo.attach(arm1Pin);
  arm2Servo.attach(arm2Pin);

  // Set initial safe starting positions
  clawServo.write(0); // Start closed
  baseServo.write(90);
  arm1Servo.write(90);
  arm2Servo.write(0);

  Serial.println("Arduino R4 Ready. All servos attached and holding position.");
}

void loop() {
  // Check if data is available on the serial port
  if (Serial.available() > 0) {
    String incomingCommand = Serial.readStringUntil('\n');
    incomingCommand.trim(); // Remove surrounding whitespace/newlines

    if (incomingCommand.length() > 0) {
      Serial.print("Received: ");
      Serial.println(incomingCommand);

      // Check if the command starts with "MOVE"
      if (incomingCommand.startsWith("MOVE ")) {
        parseCommand(incomingCommand);
      } else {
        Serial.println("UNKNOWN COMMAND");
      }
    }
  }
}

// Parses the "MOVE X Y Z" string (Pi already applied the -40mm X offset)
void parseCommand(String command) {
  int firstSpace = command.indexOf(' ');
  int secondSpace = command.indexOf(' ', firstSpace + 1);
  int thirdSpace = command.indexOf(' ', secondSpace + 1);

  if (firstSpace != -1 && secondSpace != -1) {
    String xStr = command.substring(firstSpace + 1, secondSpace);
    
    String yStr;
    if (thirdSpace != -1) {
      yStr = command.substring(secondSpace + 1, thirdSpace);
      String zStr = command.substring(thirdSpace + 1);
      targetZ = zStr.toFloat();
    } else {
      yStr = command.substring(secondSpace + 1);
      targetZ = 0.0; 
    }

    targetX = xStr.toFloat();
    targetY = yStr.toFloat();

    // Print parsed coordinates for debugging
    Serial.print("Target Received -> X (Compensated): ");
    Serial.print(targetX);
    Serial.print(" mm | Y: ");
    Serial.print(targetY);
    Serial.print(" mm | Z: ");
    Serial.print(targetZ);
    Serial.println(" mm");

    // Execute the robot arm pickup sequence
    executeMoveSequence(targetX, targetY, targetZ);

  } else {
    Serial.println("ERROR: Invalid MOVE format syntax.");
  }
}

// Inverse Kinematics calculation helper
bool calculateIK(float x, float y, float z, int &baseAngle, int &arm1Angle, int &arm2Angle) {
  // 1. Base rotation angle (atan2 of X and Y)
  float baseRad = atan2(x, y);
  baseAngle = degrees(baseRad) + 90; // Offset center if needed

  // 2. Planar distance (r) and height (z) for 2D arm calculation
  float r = sqrt(x * x + y * y);
  float distSq = r * r + z * z;
  float dist = sqrt(distSq);

  // Check if target is out of reach
  if (dist > (L1 + L2) || dist < abs(L1 - L2)) {
    return false; // Out of reach
  }

  // Law of cosines for arm joints
  float cosTheta2 = (distSq - (L1 * L1 + L2 * L2)) / (2.0 * L1 * L2);
  float sinTheta2 = sqrt(1.0 - cosTheta2 * cosTheta2);
  float theta2 = atan2(sinTheta2, cosTheta2);

  float theta1 = atan2(z, r) - atan2(L2 * sinTheta2, L1 + L2 * cosTheta2);

  arm1Angle = degrees(theta1);
  arm2Angle = degrees(theta2);

  // Constrain to valid servo ranges (0-180)
  baseAngle = constrain(baseAngle, 0, 180);
  arm1Angle = constrain(arm1Angle, 0, 180);
  arm2Angle = constrain(arm2Angle, 0, 180);

  return true;
}

// Helper to move all active arm servos smoothly together
void moveArmSmoothly(int targetBase, int targetArm1, int targetArm2, int speedDelay) {
  int currentBase = baseServo.read();
  int currentArm1 = arm1Servo.read();
  int currentArm2 = arm2Servo.read();

  // Find the maximum steps needed so all joints finish moving together
  int maxSteps = max(max(abs(targetBase - currentBase), abs(targetArm1 - currentArm1)), abs(targetArm2 - currentArm2));

  for (int i = 1; i <= maxSteps; i++) {
    int b = round(currentBase + (targetBase - currentBase) * ((float)i / maxSteps));
    int a1 = round(currentArm1 + (targetArm1 - currentArm1) * ((float)i / maxSteps));
    int a2 = round(currentArm2 + (targetArm2 - currentArm2) * ((float)i / maxSteps));

    baseServo.write(b);
    arm1Servo.write(a1);
    arm2Servo.write(a2);
    delay(speedDelay); // Controls movement smoothness speed (lower = faster, higher = slower)
  }
}

// Hardware control logic for your robot arm
void executeMoveSequence(float x, float y, float z) {
  Serial.println("--- Starting Pickup Sequence ---");

  // 0. Ensure the claw is open before approaching the object
  Serial.println("Opening claw...");
  clawServo.write(180); 
  delay(500);

  // Calculate IK angles for the target (X, Y, Z)
  int bAngle = 90, a1Angle = 90, a2Angle = 90;
  if (calculateIK(x, y, z, bAngle, a1Angle, a2Angle)) {
    Serial.println("IK Solved. Moving smoothly to target coordinates...");
    
    // 1. Smoothly move base and arm to target position
    moveArmSmoothly(bAngle, a1Angle, a2Angle, 15); // Adjust '15' for faster/slower movement speed

  } else {
    Serial.println("ERROR: Target coordinates are out of reach!");
    return;
  }

  // 2. Close the claw to grab the object
  Serial.println("Closing claw...");
  clawServo.write(0); 
  
  // Wait a full second after the claw closes to secure the grip
  delay(1000); 

  // 3. Lift back up smoothly with the object (e.g., return arm1/arm2 to neutral 90°)
  Serial.println("Lifting object...");
  moveArmSmoothly(bAngle, 90, 90, 15);

  Serial.println("--- Sequence Complete ---");
}
